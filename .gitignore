# Compiled lab binaries (rebuilt by scripts/build_cpp.py, gpu/run_gpu.sh)
solutions/**/cpp/bin/
solutions/**/gpu/bin/

# LaTeX intermediates; only .tex, .bib and .pdf are committed (figures are read from the labs' artifacts/figures)
